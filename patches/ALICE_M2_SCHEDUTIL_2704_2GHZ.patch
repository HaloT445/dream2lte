--- a/kernel/drivers/cpufreq/alice_m2_boost.c
+++ b/kernel/drivers/cpufreq/alice_m2_boost.c
@@
+#define ALICE_M2_NORMAL_KHZ		2314000U
+#define ALICE_M2_BOOST_KHZ		2704000U
+#define ALICE_A53_LOAD_PCT		85U
+#define ALICE_A53_NEAR_MAX_KHZ		2000000U
+#define ALICE_BURST_MS			180U
+#define ALICE_WINDOW_MS			480U
+#define ALICE_THERMAL_OFF_MC		65000
+#define ALICE_THERMAL_REARM_MC		62000
+#define ALICE_BATT_REMAIN_UAH		1200000LL
+#define ALICE_BATT_DESIGN_UAH		3200000LL
+
+/* The controller changes only the M2 maximum QoS. schedutil remains responsible
+ * for selecting the actual frequency, so M2 may stay at its lowest available
+ * OPP and rises only when schedutil requests it under the temporary 2704-MHz cap. */
--- a/kernel/drivers/cpufreq/Makefile
+++ b/kernel/drivers/cpufreq/Makefile
@@
+obj-$(CONFIG_ALICE_M2_BOOST) += alice_m2_boost.o
--- a/kernel/drivers/cpufreq/Kconfig
+++ b/kernel/drivers/cpufreq/Kconfig
@@
+config ALICE_M2_BOOST
+	tristate "Alice Exynos8895 M2 conditional boost"
+	depends on CPU_FREQ
+	depends on THERMAL
+	depends on POWER_SUPPLY
+	default y
+	help
+	  Keep M2 at a 2314 MHz normal ceiling and temporarily permit a
+	  2704 MHz ceiling when all A53 cores are >=2.0 GHz and average
+	  A53 load is >=85%. Burst is limited to 180 ms per 480 ms window.
--- a/kernel/arch/arm64/configs/alice_dream2lte_susfs_defconfig
+++ b/kernel/arch/arm64/configs/alice_dream2lte_susfs_defconfig
@@
+CONFIG_SCHED_HMP=y
+CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
+CONFIG_ALICE_M2_BOOST=y
+# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set
+# CONFIG_SUPPORT_DOZE is not set
